# =============================================================================
# Kubernetes Secret Template for InsightSphere STUDIO
# NEVER commit real secrets to Git!
#
# Quick Setup Command (automatically reads from your local .env file):
#   kubectl create secret generic insightsphere-secrets --from-env-file=.env
#
# Or copy this file to k8s/secret.yaml (gitignored), fill base64/stringData values,
# and run: kubectl apply -f k8s/secret.yaml
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: insightsphere-secrets
type: Opaque
stringData:
  YOUTUBE_API_KEY: "your-youtube-data-api-v3-key"
  JWT_SECRET_KEY: "change-me-to-a-strong-random-secret"
  FROM_EMAIL: "your-sender-email@gmail.com"
  EMAIL_PASSWORD: "your-16-char-google-app-password"
