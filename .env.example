# Copy this file to .env and fill in local values.
# Never commit .env or real keys.

FLASK_ENV=development
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=network

# Required for YouTube-backed pages (sentiment, trending, recommendations).
# Create a key in Google Cloud (YouTube Data API v3). Rotate any key that was
# previously committed in this repository.
YOUTUBE_API_KEY=

# Used for /auth JWT tokens. Use a long random string.
JWT_SECRET_KEY=change-me-in-local-dev

# Optional: report emails (blueprints/send.py)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
FROM_EMAIL=
EMAIL_PASSWORD=

# Optional later (Milestone 3). Leave empty so analytics still run without an LLM.
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
