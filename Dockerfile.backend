# =============================================================================
# InsightSphere Backend - Production Dockerfile
# =============================================================================

# 1. Base Image: Official lightweight Python 3.11 Linux (~130MB)
FROM python:3.11-slim

# 2. Performance & Log Streaming Flags
# - PYTHONUNBUFFERED=1: Forces stdout/stderr to be unbuffered so logs stream instantly
# - PYTHONDONTWRITEBYTECODE=1: Prevents writing .pyc files inside the container
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# 3. Define the working directory inside the container
WORKDIR /app

# 4. Copy requirements.txt first (Leverages Docker Layer Caching)
# If requirements.txt has not changed, Docker skips downloading packages on rebuilds
COPY requirements.txt .

# 5. Install dependencies without caching pip wheel files to keep image size small
RUN pip install --no-cache-dir -r requirements.txt

# 6. Pre-download NLTK stopwords & vader_lexicon inside the image
# This ensures zero runtime download latency or network failure when the container boots
RUN python -m nltk.downloader -d /usr/local/share/nltk_data stopwords vader_lexicon

# 7. Copy application source code into /app
COPY . .

# 8. Document that Flask listens on port 5000
EXPOSE 5000

# 9. Start command
CMD ["python", "app.py"]
